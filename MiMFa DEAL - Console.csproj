<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net5.0</TargetFramework>

		<RootNamespace>MiMFa.Engine.DEAL.Console</RootNamespace>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>

		<Company>MiMFa</Company>
		<Product>DEAL</Product>
		<Authors>Mohammad Fathi (MiMFa)</Authors>

		<ApplicationIcon>logo.ico</ApplicationIcon>
		<OutputType>Exe</OutputType>
		<StartupObject>MiMFa.Engine.DEAL.Environment.Program</StartupObject>

		<PackageId>MiMFa DEAL - Environment</PackageId>

		<!-- ClearScript native package is win-x86 -->
		<PlatformTarget>x86</PlatformTarget>
		<AssemblyName>DEAL</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Console\.djs" />
	  <None Remove="Console\controls.djs" />
	  <None Remove="Console\dialogs.djs" />
	  <None Remove="Console\displays.djs" />
	  <None Remove="Console\log.djs" />
	  <None Remove="Console\resources.djs" />
	  <None Remove="Console\tasks.djs" />
	  <None Remove="final.djs" />
	  <None Remove="initial.djs" />
	  <None Remove="snippet.djs" />
	  <None Remove="~survival.djs" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="Console\.djs">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Console\controls.djs">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Console\dialogs.djs">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Console\displays.djs">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Console\log.djs">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Console\resources.djs">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Console\tasks.djs">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="final.djs">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="initial.djs">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Temporary\snippet.djs">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="~survival.djs">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.ClearScript" Version="7.5.1.1" />
		<PackageReference Include="Microsoft.ClearScript.V8" Version="7.5.1.1" />
		<PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<ItemGroup>
		<None Include="LICENSE" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MiMFa DEAL - Engine\MiMFa DEAL - Engine.csproj" />
		<ProjectReference Include="..\MiMFa DEAL.JS - Engine\MiMFa DEAL.JS - Engine.csproj" />
	</ItemGroup>

</Project>