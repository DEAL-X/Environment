<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net5.0</TargetFramework>

		<RootNamespace>MiMFa.Engine.DEAL.Environment</RootNamespace>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>

		<Company>MiMFa</Company>
		<Product>DEAL</Product>
		<Authors>Mohammad Fathi (MiMFa)</Authors>

		<ApplicationIcon>logo.ico</ApplicationIcon>
		<OutputType>Exe</OutputType>
		<StartupObject>MiMFa.Engine.DEAL.Environment.Program</StartupObject>

		<PackageId>MiMFa DEAL - Environment</PackageId>

		<!-- ClearScript native package is win-x86 -->
		<PlatformTarget>x86</PlatformTarget>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.ClearScript.V8" Version="7.5.1.1" />
		<PackageReference Include="Microsoft.ClearScript.V8.Native.win-x86" Version="7.5.1.1" />
		<PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<ItemGroup>
		<None Include="LICENSE" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MiMFa DEAL - Engine\MiMFa DEAL - Engine.csproj" />
		<ProjectReference Include="..\MiMFa DEAL.JS - Compiler\MiMFa DEAL.JS.csproj" />
		<ProjectReference Include="..\MiMFa DEAL.JS - Engine\MiMFa DEAL.JS - Engine.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="Library\final.djs">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Library\manual.djs">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="Library\initial.djs">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>